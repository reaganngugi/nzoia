{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start workspace server",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "http.server",
        "5500",
        "--directory",
        "${workspaceFolder}",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
